# Environnement : "dev" (défaut) autorise l'auto-création/seed des bases au démarrage
# du backend (SQLite users, schéma MySQL). Mettre "prod" sur AWS pour désactiver cette
# auto-init : en prod, les bases sont peuplées une fois via restauration de dump.
ENV=dev

# Mots de passe des comptes de seed (dev uniquement, cf. backend/db_init/db_users.py).
# Requis quand ENV=dev : générer des valeurs, ex. python -c "import secrets; print(secrets.token_urlsafe(18))"
SEED_ADMIN_PASSWORD=change
SEED_CONTRIBUTOR1_PASSWORD=change
SEED_USER1_PASSWORD=change
SEED_CONTRIBUTOR2_PASSWORD=change

# base mysql
DB_HOST=db_randovango
DB_ROOT=root
DB_ROOT_PSWD=change
DB_NAME=bdd_randovango
DB_USER=randovango_user
DB_PSWD=change

# docker
MYSQL_PORT=3306
ADMINER_PORT=8080

# mongo db
MONGO_INITDB_ROOT_USERNAME=rootuser
MONGO_INITDB_ROOT_PASSWORD=change
MONGO_HOST=mongo_randovango
MONGO_PORT=27017
DATABASE_NAME=randovango

# Secret de signature des JWT (backend). Générer une valeur aléatoire forte, ex. :
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=changeme_generate_a_strong_random_value

# CORS / API (frontend <-> backend)
ALLOWED_ORIGINS=http://localhost,http://127.0.0.1
PUBLIC_API_BASE_URL=http://localhost:8000

# Flask : mode debug (reload + débogueur). 1 en local UNIQUEMENT ; laisser 0 quand exposé.
FLASK_DEBUG=0

# Harmonisation des descriptions des spots (backend/agents). Facultative : sans elle
# l'ETL tourne normalement, les spots restent affichés avec leurs champs p4n.
# Clé à créer sur https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Alternative à la clé d'API : harmonisation via l'abonnement Claude (Pro/Max), avec
# `--engine claude-code`. Jeton longue durée généré sur l'hôte par : claude setup-token
CLAUDE_CODE_OAUTH_TOKEN=

# Agents IA : moteur et modèle derrière chaque niveau (agents/llm_config.py).
# api : clé ANTHROPIC_API_KEY ; claude-code : programme `claude` et abonnement.
# Versions exactes, jamais d'alias : changer de modèle se valide par un pilote.
LLM_ENGINE=claude-code
LLM_MODEL_QUALITE=claude-opus-5-5
LLM_MODEL_RAPIDE=claude-sonnet-5-5
